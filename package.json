{
  "name": "dsh-sdk-mcp",
  "version": "0.6.0-rc.2",
  "description": "SDK-native MCP bridge for using DeepSeek Harness as a persistent and parallel coding subagent.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ELRdn/DSH-SDK-MCP.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-sdk-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "COMPATIBILITY.md",
    "SECURITY.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek-harness",
    "dsh",
    "subagent",
    "stdio"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package:dry-run": "npm pack --dry-run --json --ignore-scripts",
    "package:inspect": "node scripts/package-audit.mjs",
    "package:smoke": "node scripts/fresh-install-smoke.mjs",
    "prepack": "npm run build",
    "phase0": "npm run build && node dist/phase0.js",
    "mcp": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.2-rc.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.7.0"
}
