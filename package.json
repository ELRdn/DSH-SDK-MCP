{
  "name": "dsh-sdk-mcp",
  "version": "0.6.0-rc.1",
  "description": "SDK-native MCP bridge for using DeepSeek Harness as a persistent and parallel coding subagent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-sdk-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "README.md",
    "COMPATIBILITY.md",
    "SECURITY.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek-harness",
    "dsh",
    "subagent",
    "stdio"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "package:dry-run": "npm pack --dry-run --json --ignore-scripts",
    "package:inspect": "node scripts/package-audit.mjs",
    "package:smoke": "node scripts/fresh-install-smoke.mjs",
    "prepack": "npm run build",
    "phase0": "npm run build && node dist/phase0.js",
    "mcp": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-pwsh": "0.1.1-rc.2",
    "@types/node": "22.19.0",
    "typescript": "5.9.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@earendil-works/pi-ai": "0.82.1"
  },
  "packageManager": "pnpm@11.7.0"
}
